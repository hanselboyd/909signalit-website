generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id               Int       @id @default(autoincrement())
  name             String
  phone            String
  email            String?
  businessName     String?
  customerType     String
  city             String
  serviceRequested String
  urgency          String
  preferredContact String
  message          String
  source           String    @default("Website")
  status           String    @default("New Lead")
  notes            String?
  lastContactedAt  DateTime?
  followUpAt       DateTime?
  followUpNote     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tickets          Ticket[]
  invoices         Invoice[]
}

model Customer {
  id           Int       @id @default(autoincrement())
  name         String
  phone        String?
  email        String?
  businessName String?
  customerType String?
  address      String?
  city         String?
  notes        String?
  followUpAt   DateTime?
  followUpNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tickets      Ticket[]
  invoices     Invoice[]
  expenses     Expense[]
}

model Ticket {
  id                   Int       @id @default(autoincrement())
  ticketNumber         String    @unique
  customerId           Int?
  leadId               Int?
  title                String
  serviceType          String?
  issue                String?
  diagnosis            String?
  workPerformed        String?
  partsNeeded          String?
  partsUsed            String?
  priceQuoted          Decimal?
  finalPrice           Decimal?
  timeSpentMinutes     Int?
  appointmentAt        DateTime?
  status               String    @default("New")
  internalNotes        String?
  customerNotes        String?
  recommendedNextSteps String?
  completedAt          DateTime?
  followUpAt           DateTime?
  followUpNote         String?
  reviewRequested      Boolean   @default(false)
  reviewReceived       Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  customer             Customer? @relation(fields: [customerId], references: [id])
  lead                 Lead?     @relation(fields: [leadId], references: [id])
  invoices             Invoice[]
  expenses             Expense[]
}

model Invoice {
  id                      Int               @id @default(autoincrement())
  invoiceNumber           String            @unique
  customerId              Int?
  leadId                  Int?
  ticketId                Int?
  customerName            String
  customerEmail           String?
  customerPhone           String?
  status                  String            @default("Draft")
  dueDate                 DateTime?
  subtotalCents           Int               @default(0)
  taxCents                Int               @default(0)
  discountCents           Int               @default(0)
  totalCents              Int               @default(0)
  notes                   String?
  paymentLink             String?
  stripeCheckoutSessionId String?
  stripePaymentLinkId     String?
  followUpAt              DateTime?
  followUpNote            String?
  sentAt                  DateTime?
  paidAt                  DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  customer                Customer?         @relation(fields: [customerId], references: [id])
  lead                    Lead?             @relation(fields: [leadId], references: [id])
  ticket                  Ticket?           @relation(fields: [ticketId], references: [id])
  lineItems               InvoiceLineItem[]
  expenses                Expense[]
}

model InvoiceLineItem {
  id             Int      @id @default(autoincrement())
  invoiceId      Int
  description    String
  quantity       Int      @default(1)
  unitPriceCents Int
  lineTotalCents Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id            String    @id @default(cuid())
  description   String
  vendor        String?
  category      String
  amountCents   Int
  expenseDate   DateTime
  paymentMethod String?
  notes         String?
  customerId    Int?
  ticketId      Int?
  invoiceId     Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  customer      Customer? @relation(fields: [customerId], references: [id])
  ticket        Ticket?   @relation(fields: [ticketId], references: [id])
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id])
}
